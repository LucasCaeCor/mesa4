                <button
                  className="secondary whatsapp-manual-button"
                  type="button"
                  disabled={
                    !order.customerPhone ||
                    order.whatsappOptIn === false
                  }
                  title={
                    order.whatsappOptIn === false
                      ? "O cliente não autorizou atualizações pelo WhatsApp"
