                      {selectedOrder.street},{" "}
                      {selectedOrder.number}
                      {selectedOrder.complement
                        ? ` — ${selectedOrder.complement}`
                        : ""}
                      <br />
                      {selectedOrder.neighborhood} —{" "}
                      {selectedOrder.city}/
                      {selectedOrder.state}
                      <br />
                      CEP {selectedOrder.postalCode}
                    </p>

                    {selectedOrder.reference && (
                      <p className="order-reference">
                        Referência:{" "}
                        {selectedOrder.reference}
                      </p>
