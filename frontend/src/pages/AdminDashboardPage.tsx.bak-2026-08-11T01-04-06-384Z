                </small>
              )}

              {update.error && (
                <p className="error-text">
                  {update.error.message}
                </p>
              )}
            </article>
          );
        })}
      </section>

      {selectedOrder && (
        <div
          className="order-detail-overlay"
          role="presentation"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              setSelectedOrderId(null);
