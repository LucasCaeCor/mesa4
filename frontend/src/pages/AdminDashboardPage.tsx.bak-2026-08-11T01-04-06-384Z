                <div className="order-detail-items">
                  {selectedOrder.items.map((item) => (
                    <article key={item.id}>
                      <div>
                        <strong>
                          {item.quantity}x{" "}
                          {item.productName}
                        </strong>
                        <span>
                          {formatMoney(
                            item.lineTotalCents,
