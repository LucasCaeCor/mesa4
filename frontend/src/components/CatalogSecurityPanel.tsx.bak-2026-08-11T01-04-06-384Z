import {
  FormEvent,
  useEffect,
  useRef,
  useState,
} from "react";
import { useMutation } from "@tanstack/react-query";
import { ShieldCheck } from "lucide-react";
import {
  adminApi,
  clearAdminStepUpAuthorization,
  setAdminStepUpAuthorization,
} from "../lib/api";

type UnlockResponse = {
  token: string;
  expiresAt: string;
  expiresInSeconds: number;
};

export function CatalogSecurityPanel({
  onAuthorization,
}: {
  onAuthorization?: (
    token: string,
  ) => void;
}) {
  const [expiresAt, setExpiresAt] =
    useState<Date | null>(null);
  const timer =
    useRef<number | null>(null);

  const unlock = useMutation({
    mutationFn: (input: {
      password: string;
      code: string;
    }) =>
      adminApi<UnlockResponse>(
        "/admin/security/admin/unlock",
        {
          method: "POST",
          body: JSON.stringify(input),
        },
      ),
    onSuccess: (data) => {
      const expiration =
        new Date(data.expiresAt);

      setAdminStepUpAuthorization(
        data.token,
        data.expiresAt,
      );
      onAuthorization?.(data.token);
      setExpiresAt(expiration);

      if (timer.current !== null) {
        window.clearTimeout(
          timer.current,
        );
      }

      timer.current =
        window.setTimeout(() => {
          clearAdminStepUpAuthorization();
          onAuthorization?.("");
          setExpiresAt(null);
        }, Math.max(
          0,
          expiration.getTime() -
            Date.now(),
        ));
    },
  });

  useEffect(
    () => () => {
      if (timer.current !== null) {
        window.clearTimeout(
          timer.current,
        );
      }
    },
    [],
  );

  function submit(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    const form =
      new FormData(event.currentTarget);

    unlock.mutate({
      password: String(
        form.get("password"),
      ),
      code: String(
        form.get("code"),
      ),
    });
  }

  const unlocked =
    expiresAt !== null &&
    expiresAt.getTime() > Date.now();

  return (
    <section className="catalog-security-panel">
      <div className="catalog-security-title">
        <div>
          <small>
            Segurança administrativa
          </small>
          <h2>
            Ações sensíveis
          </h2>
        </div>

        <span
          className={
            unlocked
              ? "catalog-lock-status unlocked"
              : "catalog-lock-status"
          }
        >
          {unlocked
            ? "Desbloqueado"
            : "Protegido"}
        </span>
      </div>

      {unlocked ? (
        <div className="catalog-unlocked">
          <ShieldCheck />
          <div>
            <strong>
              Alterações sensíveis
              liberadas
            </strong>
            <small>
              Até{" "}
              {expiresAt?.toLocaleTimeString(
                "pt-BR",
                {
                  hour: "2-digit",
                  minute: "2-digit",
                },
              )}
              . O desbloqueio não é salvo
              no navegador.
            </small>
          </div>
        </div>
      ) : (
        <>
          <p>
            Criar produtos, salvar
            preços, excluir produtos e
            alterar adicionais com
            preço exige senha +
            Authenticator.
          </p>

          <form
            className="catalog-unlock-form"
            onSubmit={submit}
          >
            <label className="field">
              <span>
                Senha administrativa
              </span>
              <input
                name="password"
                type="password"
                autoComplete="current-password"
                minLength={8}
                required
              />
            </label>

            <label className="field">
              <span>
                Authenticator
              </span>
              <input
                name="code"
                inputMode="text"
                autoComplete="one-time-code"
                autoCapitalize="characters"
                placeholder="123456"
                required
              />
            </label>

            <button
              className="secondary"
              disabled={unlock.isPending}
            >
              <ShieldCheck />
              {unlock.isPending
                ? "Verificando..."
                : "Desbloquear por 10 min"}
            </button>
          </form>

          {unlock.error && (
            <p className="error-text">
              {unlock.error.message}
            </p>
          )}
        </>
      )}
    </section>
  );
}
