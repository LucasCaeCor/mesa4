import type {
  FastifyInstance,
  FastifyRequest,
} from "fastify";
import bcrypt from "bcryptjs";
import QRCode from "qrcode";
import { randomBytes } from "node:crypto";
import { z } from "zod";
import { prisma } from "../lib/prisma.js";
import { HttpError } from "../lib/http-error.js";
import {
  decryptSecret,
  encryptSecret,
} from "../lib/secret-box.js";
import {
  buildOtpAuthUri,
  generateTotpSecret,
  verifyTotp,
} from "../lib/totp.js";
import {
  createPixChangeAuthorization,
} from "../modules/security/pix-security.service.js";
import {
  createAdminStepUpAuthorization,
} from "../modules/security/admin-stepup-security.service.js";

const passwordSchema = z.object({
  password: z
    .string()
    .min(8)
    .max(200),
});

const confirmSchema = z.object({
  code: z
    .string()
    .trim()
    .regex(/^\d{6}$/),
});

const unlockSchema = z.object({
  password: z
    .string()
    .min(8)
    .max(200),
  code: z
    .string()
    .trim()
    .min(6)
    .max(32),
});

function normalizeRecoveryCode(
  value: string,
) {
  return value
    .trim()
    .toUpperCase()
    .replace(/[^A-F0-9]/g, "");
}

function generateRecoveryCodes() {
  return Array.from(
    { length: 8 },
    () => {
      const raw = randomBytes(8)
        .toString("hex")
        .toUpperCase();

      return raw.match(/.{1,4}/g)!.join("-");
    },
  );
}

async function auditSecurity(
  request: FastifyRequest,
  action: string,
  metadata?: unknown,
) {
  await prisma.auditLog.create({
    data: {
      adminId: request.user?.sub,
      action,
      entity: "PIX_SECURITY",
      metadata: metadata as never,
      ip: request.ip,
    },
  });
}

async function getAdminWithPassword(
  request: FastifyRequest,
  password: string,
) {
  const admin =
    await prisma.adminUser.findUnique({
      where: {
        id: request.user.sub,
      },
    });

  if (
    !admin ||
    !admin.active ||
    !(await bcrypt.compare(
      password,
      admin.passwordHash,
    ))
  ) {
    throw new HttpError(
      401,
      "Senha administrativa inválida",
      "INVALID_ADMIN_PASSWORD",
    );
  }

  return admin;
}

async function verifySecondFactor(
  admin: Awaited<
    ReturnType<
      typeof prisma.adminUser.findUnique
    >
  >,
  code: string,
) {
  if (
    !admin ||
    !admin.pixTotpEnabled ||
    !admin.pixTotpSecretEncrypted
  ) {
    throw new HttpError(
      409,
      "O Authenticator ainda não foi configurado",
      "PIX_TOTP_NOT_CONFIGURED",
    );
  }

  if (/^\d{6}$/.test(code.trim())) {
    const secret = decryptSecret(
      admin.pixTotpSecretEncrypted,
    );
    const matchedCounter = verifyTotp(
      secret,
      code,
      {
        window: 1,
      },
    );

    if (matchedCounter === null) {
      throw new HttpError(
        401,
        "Código do Authenticator inválido",
        "INVALID_TOTP_CODE",
      );
    }

    if (
      admin.pixTotpLastUsedCounter !==
        null &&
      admin.pixTotpLastUsedCounter !==
        undefined &&
      matchedCounter <=
        admin.pixTotpLastUsedCounter
    ) {
      throw new HttpError(
        401,
        "Este código já foi utilizado. Aguarde o próximo código do Authenticator",
        "TOTP_CODE_ALREADY_USED",
      );
    }

    await prisma.adminUser.update({
      where: {
        id: admin.id,
      },
      data: {
        pixTotpLastUsedCounter:
          matchedCounter,
      },
    });

    return "TOTP" as const;
  }

  const normalized =
    normalizeRecoveryCode(code);
  const hashes = Array.isArray(
    admin.pixTotpRecoveryCodeHashes,
  )
    ? admin.pixTotpRecoveryCodeHashes.filter(
        (
          item,
        ): item is string =>
          typeof item === "string",
      )
    : [];

  for (
    let index = 0;
    index < hashes.length;
    index += 1
  ) {
    if (
      await bcrypt.compare(
        normalized,
        hashes[index],
      )
    ) {
      const remaining = hashes.filter(
        (_, currentIndex) =>
          currentIndex !== index,
      );

      await prisma.adminUser.update({
        where: {
          id: admin.id,
        },
        data: {
          pixTotpRecoveryCodeHashes:
            remaining,
        },
      });

      return "RECOVERY_CODE" as const;
    }
  }

  throw new HttpError(
    401,
    "Código do Authenticator ou código de recuperação inválido",
    "INVALID_SECOND_FACTOR",
  );
}

export async function pixSecurityRoutes(
  app: FastifyInstance,
) {
  app.get(
    "/admin/security/pix-totp/status",
    {
      preHandler: app.authenticateAdmin,
    },
    async (request) => {
      const admin =
        await prisma.adminUser.findUnique({
          where: {
            id: request.user.sub,
          },
          select: {
            pixTotpEnabled: true,
            pixTotpRecoveryCodeHashes:
              true,
          },
        });

      return {
        enabled:
          admin?.pixTotpEnabled ?? false,
        recoveryCodesRemaining:
          Array.isArray(
            admin?.pixTotpRecoveryCodeHashes,
          )
            ? admin
                .pixTotpRecoveryCodeHashes
                .length
            : 0,
      };
    },
  );

  app.post(
    "/admin/security/pix-totp/setup",
    {
      preHandler: app.authenticateAdmin,
      config: {
        rateLimit: {
          max: 5,
          timeWindow: "15 minutes",
        },
      },
    },
    async (request) => {
      const input =
        passwordSchema.parse(request.body);
      const admin =
        await getAdminWithPassword(
          request,
          input.password,
        );

      if (admin.pixTotpEnabled) {
        throw new HttpError(
          409,
          "A autenticação do Pix já está configurada",
          "PIX_TOTP_ALREADY_ENABLED",
        );
      }

      const secret =
        generateTotpSecret();
      const pendingExpiresAt =
        new Date(
          Date.now() + 10 * 60 * 1000,
        );

      await prisma.adminUser.update({
        where: {
          id: admin.id,
        },
        data: {
          pixTotpPendingSecretEncrypted:
            encryptSecret(secret),
          pixTotpPendingExpiresAt:
            pendingExpiresAt,
        },
      });

      const issuer = "Mesa IV Burgers";
      const otpauthUri =
        buildOtpAuthUri({
          secret,
          accountName: admin.email,
          issuer,
        });
      const qrCodeDataUrl =
        await QRCode.toDataURL(
          otpauthUri,
          {
            width: 260,
            margin: 1,
            errorCorrectionLevel: "M",
          },
        );

      await auditSecurity(
        request,
        "PIX_TOTP_SETUP_STARTED",
      );

      return {
        qrCodeDataUrl,
        manualKey: secret,
        expiresAt:
          pendingExpiresAt.toISOString(),
      };
    },
  );

  app.post(
    "/admin/security/pix-totp/confirm",
    {
      preHandler: app.authenticateAdmin,
      config: {
        rateLimit: {
          max: 8,
          timeWindow: "15 minutes",
        },
      },
    },
    async (request) => {
      const input =
        confirmSchema.parse(request.body);
      const admin =
        await prisma.adminUser.findUnique({
          where: {
            id: request.user.sub,
          },
        });

      if (
        !admin ||
        !admin
          .pixTotpPendingSecretEncrypted ||
        !admin.pixTotpPendingExpiresAt ||
        admin.pixTotpPendingExpiresAt <
          new Date()
      ) {
        throw new HttpError(
          409,
          "A configuração do Authenticator expirou. Inicie novamente",
          "PIX_TOTP_SETUP_EXPIRED",
        );
      }

      const secret = decryptSecret(
        admin
          .pixTotpPendingSecretEncrypted,
      );
      const matchedCounter =
        verifyTotp(
          secret,
          input.code,
          {
            window: 1,
          },
        );

      if (matchedCounter === null) {
        throw new HttpError(
          401,
          "Código do Authenticator inválido",
          "INVALID_TOTP_CODE",
        );
      }

      const recoveryCodes =
        generateRecoveryCodes();
      const recoveryHashes =
        await Promise.all(
          recoveryCodes.map(
            (code) =>
              bcrypt.hash(
                normalizeRecoveryCode(
                  code,
                ),
                10,
              ),
          ),
        );

      const wasReplacing =
        admin.pixTotpEnabled;

      await prisma.adminUser.update({
        where: {
          id: admin.id,
        },
        data: {
          pixTotpEnabled: true,
          pixTotpSecretEncrypted:
            admin
              .pixTotpPendingSecretEncrypted,
          pixTotpPendingSecretEncrypted:
            null,
          pixTotpPendingExpiresAt:
            null,
          pixTotpLastUsedCounter:
            matchedCounter,
          pixTotpRecoveryCodeHashes:
            recoveryHashes,
        },
      });

      await prisma.pixChangeAuthorization.updateMany({
        where: {
          adminId: admin.id,
          usedAt: null,
        },
        data: {
          usedAt: new Date(),
        },
      });

      await auditSecurity(
        request,
        wasReplacing
          ? "PIX_TOTP_REPLACED"
          : "PIX_TOTP_ENABLED",
        {
          recoveryCodesGenerated:
            recoveryCodes.length,
        },
      );

      return {
        enabled: true,
        recoveryCodes,
      };
    },
  );

  /* MESA4_PIX_TOTP_REPLACE_V2 */
  app.post(
    "/admin/security/pix-totp/replace/start",
    {
      preHandler: app.authenticateAdmin,
      config: {
        rateLimit: {
          max: 5,
          timeWindow: "15 minutes",
        },
      },
    },
    async (request) => {
      const input =
        unlockSchema.parse(request.body);

      const admin =
        await getAdminWithPassword(
          request,
          input.password,
        );

      const method =
        await verifySecondFactor(
          admin,
          input.code,
        );

      const secret =
        generateTotpSecret();

      const pendingExpiresAt =
        new Date(
          Date.now() + 10 * 60 * 1000,
        );

      await prisma.adminUser.update({
        where: {
          id: admin.id,
        },
        data: {
          pixTotpPendingSecretEncrypted:
            encryptSecret(secret),
          pixTotpPendingExpiresAt:
            pendingExpiresAt,
        },
      });

      // Invalida desbloqueios financeiros
      // antigos quando a troca é iniciada.
      await prisma.pixChangeAuthorization.updateMany({
        where: {
          adminId: admin.id,
          usedAt: null,
        },
        data: {
          usedAt: new Date(),
        },
      });

      const issuer =
        "Mesa IV Burgers";

      const otpauthUri =
        buildOtpAuthUri({
          secret,
          accountName: admin.email,
          issuer,
        });

      const qrCodeDataUrl =
        await QRCode.toDataURL(
          otpauthUri,
          {
            width: 260,
            margin: 1,
            errorCorrectionLevel: "M",
          },
        );

      await auditSecurity(
        request,
        "PIX_TOTP_REPLACEMENT_STARTED",
        {
          method,
        },
      );

      return {
        qrCodeDataUrl,
        manualKey: secret,
        expiresAt:
          pendingExpiresAt.toISOString(),
      };
    },
  );

  app.post(
    "/admin/security/pix/unlock",
    {
      preHandler: app.authenticateAdmin,
      config: {
        rateLimit: {
          max: 5,
          timeWindow: "15 minutes",
        },
      },
    },
    async (request) => {
      const input =
        unlockSchema.parse(request.body);
      const admin =
        await getAdminWithPassword(
          request,
          input.password,
        );

      const method =
        await verifySecondFactor(
          admin,
          input.code,
        );

      const authorization =
        await createPixChangeAuthorization(
          admin.id,
        );

      await auditSecurity(
        request,
        "PIX_SETTINGS_UNLOCKED",
        {
          method,
          expiresAt:
            authorization.expiresAt,
        },
      );

      return {
        token: authorization.token,
        expiresAt:
          authorization.expiresAt.toISOString(),
        expiresInSeconds:
          authorization.expiresInSeconds,
      };
    },
  );
  app.post(
    "/admin/security/admin/unlock",
    {
      preHandler: app.authenticateAdmin,
      config: {
        rateLimit: {
          max: 5,
          timeWindow: "15 minutes",
        },
      },
    },
    async (request) => {
      const input =
        unlockSchema.parse(request.body);

      const admin =
        await getAdminWithPassword(
          request,
          input.password,
        );

      const method =
        await verifySecondFactor(
          admin,
          input.code,
        );

      const authorization =
        createAdminStepUpAuthorization(
          app,
          admin.id,
        );

      await auditSecurity(
        request,
        "ADMIN_SENSITIVE_ACTIONS_UNLOCKED",
        {
          method,
          expiresAt:
            authorization.expiresAt,
        },
      );

      return {
        token: authorization.token,
        expiresAt:
          authorization.expiresAt.toISOString(),
        expiresInSeconds:
          authorization.expiresInSeconds,
      };
    },
  );

}
